# GameMatch — environment for the compose stack.
#
#   cp .env.example .env
#
# .env is gitignored (.env.* with !.env.example); this file is the committed
# template. It serves two hosts with one docker-compose.yml: edit the local
# block or the VPS block below, nothing else changes.

# --- Host and ports ---------------------------------------------------------
# Where TLS is served. localhost uses Caddy's internal CA, which no phone or
# browser trusts; use the real domain on the VPS so ACME can issue for it.
GAMEMATCH_SITE=localhost
# Host-side ports. Change these when 80 or 443 is already taken locally.
HTTP_PORT=80
HTTPS_PORT=443

# --- local (APP_ENV=local) --------------------------------------------------
# Fixed sign-in code 123456 and SMS delivered to the container log.
APP_ENV=local
APP_DEBUG=true
DEV_OTP=123456

# --- VPS (APP_ENV=production): uncomment and fill ---------------------------
# Comment the three local lines above and uncomment these. Config.Validate()
# enforces all of them, but only once APP_ENV=production: DEV_OTP replaces the
# random OTP with a constant, APP_DEBUG returns the OTP in the response body,
# and SMS_PROVIDER=log writes every code to the container log in cleartext.
#
# DEV_OTP is commented out rather than given an empty value. An empty value does
# happen to be read as unset, but a commented line is visibly absent — which is
# what a reader of this file has to be able to tell at a glance.
#
# APP_ENV=production
# APP_DEBUG=false
# DEV_OTP=                 must stay unset
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TURNSTILE_SECRET=
#
# Optional web push (generate a keypair with `gamematch vapid`):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
#
# deploy/gamematch.env.example documents the same variables, plus the Google
# and Apple sign-in client IDs, for the systemd deployment.
