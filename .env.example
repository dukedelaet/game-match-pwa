# GameMatch — environment for the compose stack.
#
#   cp .env.example .env
#
# .env is gitignored (.env.* with !.env.example); this file is the committed
# template. Two complete configurations follow, and one docker-compose.yml
# serves both. To deploy to a VPS: comment out every line of the local block,
# then uncomment every line of the VPS block. Each block is a complete set of
# settings — nothing has to be carried across from the other, and nothing has
# to be looked up anywhere else. The prose is kept outside the blocks on
# purpose, so uncommenting a block cannot uncomment an explanation.
#
# WEB PUSH at the end is optional and applies to either host.

# Sign-in code is the fixed 123456 and one-time codes go to the container log,
# so nothing is sent to a real phone number. GAMEMATCH_SITE=localhost serves
# HTTPS with Caddy's internal CA, which a phone will not trust; that is fine
# for a browser on this machine and nothing else.
# --- local: this machine (APP_ENV=local) -----------------------------------
GAMEMATCH_SITE=localhost
HTTP_PORT=80
HTTPS_PORT=443
APP_ENV=local
APP_DEBUG=true
DEV_OTP=123456
HOUSE_USER_ID=00000000-0000-4000-8000-000000000001

# GAMEMATCH_SITE is the domain ACME issues for: left at localhost, Caddy never
# contacts Let's Encrypt and every visitor gets a certificate name mismatch.
# HTTP_PORT and HTTPS_PORT only need changing if 80 and 443 are already taken.
#
# Config.Validate() enforces the second half of this block, and enforces it
# only once APP_ENV=production. DEV_OTP replaces the random OTP with a
# constant, APP_DEBUG returns the OTP in the response body, and
# SMS_PROVIDER=log writes every code to the container log in cleartext. Leave
# any of them at their local value and the server refuses to boot.
#
# DEV_OTP is commented out rather than given an empty value: it has to be
# absent, and an empty value would sit in the file looking like a setting.
# There is deliberately no reminder text on that line below, so uncommenting it
# by accident cannot turn the reminder into the value.
#
# Apple and Google sign-in cannot be configured. The server answers those
# routes with "Sign-in is not configured yet. Use a phone code.", so there are
# no keys for them to set here.
# --- VPS: public host (APP_ENV=production) ----------------------------------
#GAMEMATCH_SITE=gamematch.example.com
#HTTP_PORT=80
#HTTPS_PORT=443
#APP_ENV=production
#APP_DEBUG=false
#DEV_OTP=
#SMS_PROVIDER=twilio
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=
#TURNSTILE_SECRET=
#HOUSE_USER_ID=00000000-0000-4000-8000-000000000001

# Optional web push, either host. Generate a keypair with: gamematch vapid
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:ops@example.com
