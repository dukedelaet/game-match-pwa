# GameMatch service environment.
# Install to /etc/gamematch/gamematch.env and edit for your host.

# Bind to loopback only; Caddy reverse-proxies /v1 to it.
ADDR=127.0.0.1:8000

# SQLite database and photo directory live here. Must be writable by the
# service user (see ReadWritePaths in the unit file).
DATA_DIR=/var/lib/gamematch

APP_ENV=production
APP_DEBUG=false

# The seeded bot opponent. Change it before first boot if you like.
HOUSE_USER_ID=00000000-0000-4000-8000-000000000001

# OTP code used when APP_DEBUG=true and no SMS provider is configured.
DEV_OTP=123456

# --- Optional: SMS delivery -------------------------------------------------
# Without these the OTP is written to the service log instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Optional: OAuth --------------------------------------------------------
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Optional: Cloudflare Turnstile ----------------------------------------
# Required on /auth/otp/start after repeated failures from one IP.
# TURNSTILE_SECRET=

# --- Optional: Web Push -----------------------------------------------------
# Generate a keypair with: gamematch vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
