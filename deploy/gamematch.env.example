# GameMatch service environment.
# Install to /etc/gamematch/gamematch.env and edit for your host.

# Bind to loopback only; Caddy reverse-proxies /v1 to it.
ADDR=127.0.0.1:8000

# SQLite database and photo directory live here. Must be writable by the
# service user (see ReadWritePaths in the unit file).
DATA_DIR=/var/lib/gamematch

APP_ENV=production
APP_DEBUG=false

# The seeded bot opponent. Change it before first boot if you like.
HOUSE_USER_ID=00000000-0000-4000-8000-000000000001

# Fixed OTP for local sign-in. MUST stay unset in production: the server
# refuses to boot if it is set while APP_ENV=production.
# DEV_OTP=123456

# --- Required in production: SMS delivery -----------------------------------
# All four must be set or the server refuses to boot. Without a real provider
# every one-time code would otherwise be written to the service journal.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Required in production: Turnstile --------------------------------------
# Set or the server refuses to boot. Challenges OTP requests after repeated
# failures from one IP.
TURNSTILE_SECRET=

# --- Optional: Web Push -----------------------------------------------------
# Generate a keypair with: gamematch vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
