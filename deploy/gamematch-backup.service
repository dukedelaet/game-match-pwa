[Unit]
Description=GameMatch backup (SQLite snapshot + photos)
Documentation=https://github.com/dukedelaet/game-match-pwa
After=gamematch.service

[Service]
Type=oneshot
User=gamematch
Group=gamematch
# scripts/backup.sh reads DATA_DIR and writes to its first argument.
Environment=DATA_DIR=/var/lib/gamematch
EnvironmentFile=-/etc/gamematch/gamematch.env
ExecStart=/opt/gamematch/scripts/backup.sh /backup/gamematch

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/gamematch /backup/gamematch

[Install]
WantedBy=multi-user.target
